{
  "name": "n8n-nodes-groupise",
  "version": "0.1.1",
  "description": "Community nodes for connecting n8n to a self-hosted Groupise API.",
  "license": "MIT",
  "author": "Groupise contributors",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "groupise",
    "webhooks",
    "automation"
  ],
  "homepage": "https://github.com/dicodetech-dev/n8n-nodes-groupwise",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dicodetech-dev/n8n-nodes-groupwise.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GroupiseApi.credentials.js",
      "dist/credentials/GroupiseWebhook.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GroupiseTrigger.node.js",
      "dist/nodes/GroupiseSend.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "n8n-workflow": "2.16.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "n8n-workflow": ">=2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
